# provision/vps/gunbatte.service — the game server process.
#
# Mirrors the kajianq-api.service pattern: one dedicated, unprivileged unit per
# app, so `systemctl restart gunbatte` can never disturb the other app. The
# binary binds 127.0.0.1 (nginx on the same host fronts it with TLS), and all
# mutable state (ladder.db, replays/) is created inside WorkingDirectory.
#
# Placeholders (__GUNBATTE_*) are substituted by provision/vps/apply.sh.

[Unit]
Description=GUNBATTE ROYALE game server (viewer, ladder, bot gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__GUNBATTE_USER__
Group=__GUNBATTE_USER__
WorkingDirectory=__GUNBATTE_DIR__
ExecStart=__GUNBATTE_DIR__/gunbatte-server serve --port __GUNBATTE_PORT__ --bind 127.0.0.1
Restart=always
RestartSec=3

# Hardening (issue #38): the unit never needs privileges; the directives
# below bound what a compromised or runaway process can reach, and cap what
# it can drain from the shared box (kajianq + Postgres share this machine).
# The only things the server ever writes are ladder.db (+ WAL/shm) and
# replays/ inside the working directory — ProtectSystem=strict makes the
# rest of the filesystem read-only, ProtectHome=read-only keeps the rest of
# the deploy identity's home out of reach, and ReadWritePaths punches the
# working directory back open. When the memory ceiling is hit, the kernel
# kills the process and systemd restarts it in 3s: live matches drop once,
# the box stays healthy.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__GUNBATTE_DIR__
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryMax=1G
CPUQuota=150%
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
